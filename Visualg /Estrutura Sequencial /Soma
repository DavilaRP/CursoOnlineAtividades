// Problema "soma"
// Fazer um programa para ler dois valores inteiros X e Y, e depois mostrar na tela o valor da soma destes
números. 

Var
   x, y : real

Inicio
      escreva("Insira o valor de X: ")
                      leia(x)
      escreva("Insira o valor de Y: ")
                      leia(y)
      escreval
      escreva("SOMA = ", x + y)
      
Fimalgoritmo
