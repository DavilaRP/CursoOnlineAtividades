// Problema "retangulo"
// Fazer um programa para ler as medidas da base e altura de um retângulo. Em seguida, mostrar o valor da área, perímetro e diagonal deste retângulo, com quatro casas decimais, conforme exemplos.

Var
   base,altura : real
   area,perimetro,diagonal : real


Inicio
      escreva("Digite a base do retângulo: ")
             leia(base)
      escreva("Digite a altura do retângulo: ")
             leia(altura)
      escreval

      area <- base * altura
      perimetro <- 2 * (base + altura)
      diagonal <- RaizQ(Exp(base,2) + Exp(altura,2))
      
      escreval("AREA = ", area:1:4)
      escreval("PERIMETRO = ", perimetro:1:4)
      escreval("DIAGONAL = ", diagonal:1:4)
      
Fimalgoritmo
