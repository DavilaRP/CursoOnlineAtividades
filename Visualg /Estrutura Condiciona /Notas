
Var
   duracao, segundos, minutosTotais, minutos, horas : inteiro


Inicio
      escreva("Digite a duração em segundos: ")
                      leia(duracao)
      segundos <- duracao % 60
      minutosTotais <- duracao \ 60
      minutos <- minutosTotais % 60
      horas <- minutosTotais \ 60
      
      escreval(horas, ":", minutos, ":", segundos)


Fimalgoritmo
